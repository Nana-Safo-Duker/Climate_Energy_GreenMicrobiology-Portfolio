# Default: normalise line endings to LF on commit
* text=auto eol=lf

# Source files
*.py   text eol=lf
*.R    text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.ipynb text eol=lf
*.json text eol=lf

# Binary files — never diff or merge as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
